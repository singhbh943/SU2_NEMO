+    ResidualReductions_FromAllThreads(
+        geometry,
+        config,
+        resRMS,
+        resMax,
+        idxMax);
+
+    /*
+     * Critical NEMO step:
+     *
+     * LinSysSol now contains DeltaU.  Determine the admissible
+     * point-local conservative-update factor before changing U.
+     */
+    ComputeUnderRelaxationFactor(config);
+
+    /*
+     * Apply the limited explicit update:
+     *
+     *   U^(n+1) = U^n + alpha * DeltaU
+     */
+    SU2_OMP_FOR_STAT(omp_chunk_size)
+    for (unsigned long iPoint = 0; iPoint < nPointDomain; ++iPoint) {
