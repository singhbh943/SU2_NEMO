+
+  su2double velocity2 = 0.0;
+  for (iDim = 0; iDim < nDim; ++iDim)
+    velocity2 += V[VEL_INDEX+iDim] * V[VEL_INDEX+iDim];
+
+  for (iSpecies = 0; iSpecies < nSpecies; ++iSpecies) {
+    const su2double e_tr =
+        es[iSpecies] - es[nSpecies+iSpecies];
