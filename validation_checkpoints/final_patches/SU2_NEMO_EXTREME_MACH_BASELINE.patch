+    CHECK(error_T < 5.0e-4);
+    CHECK(error_Tve < 5.0e-4);
+  }
+
+  for (size_t i = 0; i < nVar; ++i)
+    nodes.SetSolution(0, i, U0[i]);
+
+  REQUIRE_FALSE(nodes.SetPrimVar(0, &fluid_model));
