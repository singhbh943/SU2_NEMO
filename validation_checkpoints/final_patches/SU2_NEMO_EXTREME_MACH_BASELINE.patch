+      delta =
+          2.0e-6 *
+          std::max(
+              std::abs(U0[column]),
+              su2double(1.0e-14));
+      REQUIRE(U0[column] > delta);
+    } else {
+      delta =
+          2.0e-6 *
+          std::max(
+              std::abs(U0[column]),
+              su2double(1.0));
+    }
